{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2017",
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitThis": false,
    "alwaysStrict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": [
      "es2015",
      "es2016",
      "es2017",
      "dom"
    ]
  },
  "exclude": [
    "node_modules/**/*",
    "dist/**/*",
    "node_modules/@react-email/heading/dist/index.d.ts",
    "node_modules/@react-email/render/dist/index.d.ts",
    "node_modules/@react-email/tailwind/dist/tailwind.d.ts"
  ]
}
